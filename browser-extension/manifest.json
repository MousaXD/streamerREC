{
  "manifest_version": 3,
  "name": "StreamRec Account Connector",
  "version": "1.0.0",
  "description": "Connect only a selected streaming platform session to your localhost StreamRec instance.",
  "key": "",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.bigo.tv/*",
    "https://*.bigo.sg/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StreamRec account connector",
    "default_popup": "connect.html"
  }
}
